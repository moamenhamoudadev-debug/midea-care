@model MediCare.Services.DTOs.PaymentHistoryViewModel
@{
    ViewData["Title"] = "Payment History - MediCare";
    var filter = Model.Filter;
    var paged = Model.PagedHistory;
    var summary = Model.Summary;
}

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> <span data-i18n="breadcrumbHome">Home</span></a></li>
            <li class="breadcrumb-item"><a asp-controller="Appointments" asp-action="MyAppointments"><span data-i18n="myAppointments">My Appointments</span></a></li>
            <li class="breadcrumb-item active" aria-current="page"><span data-i18n="paymentHistoryTitle">Payment History</span></li>
        </ol>
    </nav>

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-wallet2 text-primary"></i>
                <span data-i18n="paymentHistoryTitle">Payment & Transaction History</span>
            </h1>
            <p class="text-muted mb-0 small" data-i18n="paymentHistorySubtitle">
                Review your consultation payments, official digital receipts, and transaction reconciliation statuses.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Appointments" asp-action="MyAppointments" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-calendar-check me-1"></i> <span data-i18n="myAppointments">My Appointments</span>
            </a>
            <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> <span data-i18n="bookAppointment">Book Consultation</span>
            </a>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold text-uppercase" data-i18n="totalPaidLabel">Total Paid</span>
                        <span class="badge bg-success-subtle text-success rounded-pill p-2"><i class="bi bi-cash-stack"></i></span>
                    </div>
                    <h3 class="h4 fw-bold text-dark mb-0">@summary.TotalPaid.ToString("N2") <small class="fs-6 fw-normal text-muted">EGP</small></h3>
                    <div class="text-success small mt-1">
                        <i class="bi bi-check-circle me-1"></i> <span data-i18n="succeededCountLabel">@summary.SucceededCount Succeeded</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold text-uppercase" data-i18n="succeededTransactionsLabel">Confirmed Visits</span>
                        <span class="badge bg-primary-subtle text-primary rounded-pill p-2"><i class="bi bi-check2-circle"></i></span>
                    </div>
                    <h3 class="h4 fw-bold text-dark mb-0">@summary.SucceededCount</h3>
                    <div class="text-muted small mt-1">
                        <span data-i18n="receiptReadyNote">Digital receipts generated</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold text-uppercase" data-i18n="pendingTransactionsLabel">Pending Checkout</span>
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill p-2"><i class="bi bi-hourglass-split"></i></span>
                    </div>
                    <h3 class="h4 fw-bold text-dark mb-0">@summary.PendingCount</h3>
                    <div class="text-warning-emphasis small mt-1">
                        <span data-i18n="pendingNotice">Awaiting completion</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 @(summary.RequiresRefundCount > 0 ? "border-danger" : "border-info")">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold text-uppercase" data-i18n="refundReconcileLabel">Refunds & Notice</span>
                        <span class="badge @(summary.RequiresRefundCount > 0 ? "bg-danger-subtle text-danger" : "bg-info-subtle text-info") rounded-pill p-2">
                            <i class="bi @(summary.RequiresRefundCount > 0 ? "bi-shield-exclamation" : "bi-arrow-counterclockwise")"></i>
                        </span>
                    </div>
                    <h3 class="h4 fw-bold text-dark mb-0">@summary.RefundedCount</h3>
                    <div class="small mt-1">
                        @if (summary.RequiresRefundCount > 0)
                        {
                            <span class="text-danger fw-semibold">
                                <i class="bi bi-exclamation-circle me-1"></i> @summary.RequiresRefundCount Action Required
                            </span>
                        }
                        else
                        {
                            <span class="text-muted" data-i18n="refundSettledNote">All accounts reconciled</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="History" class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1" data-i18n="searchFilterLabel">Search Reference / Doctor</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control" placeholder="Ref code, doctor name, appointment ID..." />
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1" data-i18n="statusFilterLabel">Status</label>
                    <select name="Status" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="Succeeded" selected="@(string.Equals(filter.Status, "Succeeded", StringComparison.OrdinalIgnoreCase))">Succeeded</option>
                        <option value="Pending" selected="@(string.Equals(filter.Status, "Pending", StringComparison.OrdinalIgnoreCase))">Pending</option>
                        <option value="Failed" selected="@(string.Equals(filter.Status, "Failed", StringComparison.OrdinalIgnoreCase))">Failed</option>
                        <option value="Expired" selected="@(string.Equals(filter.Status, "Expired", StringComparison.OrdinalIgnoreCase))">Expired</option>
                        <option value="Refunded" selected="@(string.Equals(filter.Status, "Refunded", StringComparison.OrdinalIgnoreCase))">Refunded</option>
                        <option value="RequiresRefund" selected="@(string.Equals(filter.Status, "RequiresRefund", StringComparison.OrdinalIgnoreCase))">Action Required</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1" data-i18n="paymentMethodFilterLabel">Payment Method</label>
                    <select name="PaymentMethod" class="form-select form-select-sm">
                        <option value="">All Methods</option>
                        <option value="Card" selected="@(string.Equals(filter.PaymentMethod, "Card", StringComparison.OrdinalIgnoreCase))">Credit / Debit Card</option>
                        <option value="MobileWallet" selected="@(string.Equals(filter.PaymentMethod, "MobileWallet", StringComparison.OrdinalIgnoreCase))">Mobile Wallet</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1" data-i18n="fromDateLabel">From Date</label>
                    <input type="date" name="FromDate" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1" data-i18n="toDateLabel">To Date</label>
                    <input type="date" name="ToDate" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>

                <div class="col-12 d-flex justify-content-between align-items-center pt-2 border-top flex-wrap gap-2">
                    <div class="text-muted small">
                        @if (!string.IsNullOrWhiteSpace(filter.SearchTerm) || !string.IsNullOrWhiteSpace(filter.Status) || !string.IsNullOrWhiteSpace(filter.PaymentMethod) || filter.FromDate.HasValue || filter.ToDate.HasValue)
                        {
                            <span class="badge bg-light text-dark border me-2"><i class="bi bi-funnel-fill text-primary me-1"></i> Active Filters</span>
                            <a asp-action="History" class="text-decoration-none small text-danger"><i class="bi bi-x-circle me-1"></i> Reset</a>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="History" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> <span data-i18n="clearFilterBtn">Clear</span>
                        </a>
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-filter me-1"></i> <span data-i18n="applyFilterBtn">Apply Filter</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table & Card View -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        @if (!paged.Items.Any())
        {
            <div class="card-body text-center py-5">
                <div class="py-4">
                    <div class="mb-3 text-muted">
                        <i class="bi bi-receipt-cutoff display-1 text-secondary opacity-50"></i>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-2" data-i18n="noPaymentRecordsTitle">No Payment Transactions Found</h3>
                    <p class="text-muted small mx-auto mb-4" style="max-width: 450px;" data-i18n="noPaymentRecordsBody">
                        There are no payment attempts or completed transactions matching your active filter criteria.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="History" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> <span data-i18n="resetFilters">Reset Filters</span>
                        </a>
                        <a asp-controller="Doctors" asp-action="Index" class="btn btn-sm btn-primary">
                            <i class="bi bi-calendar-plus me-1"></i> <span data-i18n="bookAppointment">Book a Consultation</span>
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" style="min-width: 170px;">Transaction / Ref</th>
                            <th scope="col" style="min-width: 200px;">Consultation</th>
                            <th scope="col">Payment Method</th>
                            <th scope="col">Amount</th>
                            <th scope="col">Status</th>
                            <th scope="col">Date (UTC)</th>
                            <th scope="col" class="text-end" style="min-width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y small">
                        @foreach (var item in paged.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold font-monospace text-dark text-truncate" style="max-width: 180px;" title="@item.MerchantReference">
                                        @(item.ProviderTransactionId ?? item.MerchantReference)
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.ProviderOrderId))
                                    {
                                        <div class="text-muted font-monospace" style="font-size: 0.75rem;" title="Paymob Order ID">
                                            Order: @item.ProviderOrderId
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.TermsVersion))
                                    {
                                        <span class="badge bg-light text-muted border text-truncate mt-1" style="font-size: 0.65rem;" title="Terms Acceptance Version">
                                            <i class="bi bi-shield-check text-success"></i> @item.TermsVersion
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="fw-semibold text-dark">@item.DoctorName</div>
                                    <div class="text-muted small">@item.Specialization</div>
                                    <div class="text-secondary mt-1" style="font-size: 0.75rem;">
                                        <i class="bi bi-calendar-event me-1"></i> @item.AppointmentDate.ToString("yyyy-MM-dd")
                                        <span class="text-muted">(@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm"))</span>
                                        <span class="badge bg-light text-dark border ms-1">#@item.AppointmentId</span>
                                    </div>
                                </td>

                                <td>
                                    @if (string.Equals(item.PaymentMethodType, "MobileWallet", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-phone text-primary"></i>
                                            <span>@(item.PaymentMethodDetail ?? "Egyptian Mobile Wallet")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-credit-card text-success"></i>
                                            <span>@(item.PaymentMethodDetail ?? "Payment Card")</span>
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="fw-bold text-dark fs-6">
                                        @item.AmountPaid.ToString("N2") <span class="small text-muted font-monospace">@item.Currency</span>
                                    </div>
                                    @if (item.DiscountAmount > 0)
                                    {
                                        <div class="text-success small" style="font-size: 0.75rem;">
                                            <i class="bi bi-tag-fill me-1"></i>-@item.DiscountAmount.ToString("N2") (@item.PromoCode)
                                        </div>
                                    }
                                </td>

                                <td>
                                    @if (item.Status == "Succeeded" || item.Status == "PartiallyRefunded" || item.Status == "Refunded")
                                    {
                                        if (item.IsRefunded)
                                        {
                                            if (item.RefundedAmount > 0 && item.RefundedAmount < item.AmountPaid)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" title="Partial refund: @item.RefundedAmount.ToString("N2") EGP returned">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Partial Refund (@item.RefundedAmount.ToString("N2") EGP)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Refunded
                                                </span>
                                            }
                                            @if (item.Refunds.Any())
                                            {
                                                <div class="text-muted small mt-1 font-monospace" style="font-size: 0.7rem;">
                                                    Ref: @item.Refunds.First().AuditReference
                                                </div>
                                            }
                                        }
                                        else if (item.ReconciliationStatus is "RequiresRefund" or "ReconciliationRequired" or "ManualInterventionRequired")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="@(item.ReconciliationReason ?? "Reconciliation alert")">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Action Required
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle-fill me-1"></i> Succeeded
                                            </span>
                                        }
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                        </span>
                                    }
                                    else if (item.Status == "Expired")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="bi bi-clock-history me-1"></i> Expired
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-x-circle me-1"></i> Failed
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="text-dark">@item.CreatedAtUtc.ToString("yyyy-MM-dd")</div>
                                    <div class="text-muted small">@item.CreatedAtUtc.ToString("HH:mm:ss") UTC</div>
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (item.CanViewReceipt)
                                        {
                                            <a asp-controller="Payment" asp-action="Receipt" asp-route-appointmentId="@item.AppointmentId" class="btn btn-sm btn-outline-primary" title="View Digital Tax Receipt">
                                                <i class="bi bi-receipt me-1"></i> <span data-i18n="receiptBtn">Receipt</span>
                                            </a>
                                        }
                                        else if (item.Status == "Pending")
                                        {
                                            <a asp-controller="Payment" asp-action="Result" asp-route-merchantReference="@item.MerchantReference" class="btn btn-sm btn-outline-warning" title="Check Live Gateway Status">
                                                <i class="bi bi-arrow-repeat me-1"></i> <span>Status</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Appointments" asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-light border text-muted" title="View Appointment Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card Layout -->
            <div class="d-md-none divide-y">
                @foreach (var item in paged.Items)
                {
                    <div class="p-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge @(item.Status == "Succeeded" ? (item.IsRefunded ? "bg-info-subtle text-info-emphasis" : "bg-success-subtle text-success") : (item.Status == "Pending" ? "bg-warning-subtle text-warning-emphasis" : "bg-danger-subtle text-danger")) mb-1">
                                    @item.Status
                                </span>
                                <div class="fw-bold font-monospace small text-truncate" style="max-width: 200px;">
                                    @(item.ProviderTransactionId ?? item.MerchantReference)
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold text-dark fs-6">@item.AmountPaid.ToString("N2") @item.Currency</span>
                                @if (item.DiscountAmount > 0)
                                {
                                    <div class="text-success small">-@item.DiscountAmount.ToString("N2") EGP</div>
                                }
                            </div>
                        </div>

                        <div class="bg-light p-2 rounded-2 small mb-2">
                            <div class="fw-semibold text-dark">@item.DoctorName <small class="text-muted fw-normal">(@item.Specialization)</small></div>
                            <div class="text-muted" style="font-size: 0.75rem;">
                                <i class="bi bi-calendar-event me-1"></i> @item.AppointmentDate.ToString("yyyy-MM-dd") @item.StartTime.ToString(@"hh\:mm")
                                <span class="ms-1">#@item.AppointmentId</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center small text-muted">
                            <div>
                                <i class="bi bi-credit-card me-1"></i> @(item.PaymentMethodDetail ?? "Payment Card")
                            </div>
                            <div>
                                @item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                            </div>
                        </div>

                        <div class="mt-2 text-end">
                            @if (item.CanViewReceipt)
                            {
                                <a asp-controller="Payment" asp-action="Receipt" asp-route-appointmentId="@item.AppointmentId" class="btn btn-sm btn-outline-primary w-100">
                                    <i class="bi bi-receipt me-1"></i> View Receipt
                                </a>
                            }
                            else if (item.Status == "Pending")
                            {
                                <a asp-controller="Payment" asp-action="Result" asp-route-merchantReference="@item.MerchantReference" class="btn btn-sm btn-outline-warning w-100">
                                    <i class="bi bi-arrow-repeat me-1"></i> Verify Payment
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Server-Side Pagination Bar -->
            @if (paged.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="small text-muted">
                        Showing <span class="fw-semibold">@((paged.PageNumber - 1) * paged.PageSize + 1)</span>
                        to <span class="fw-semibold">@Math.Min(paged.PageNumber * paged.PageSize, paged.TotalCount)</span>
                        of <span class="fw-semibold">@paged.TotalCount</span> transactions
                    </div>

                    <nav aria-label="Payment history pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(paged.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="History"
                                   asp-route-Page="@(paged.PageNumber - 1)"
                                   asp-route-PageSize="@paged.PageSize"
                                   asp-route-SearchTerm="@filter.SearchTerm"
                                   asp-route-Status="@filter.Status"
                                   asp-route-PaymentMethod="@filter.PaymentMethod"
                                   asp-route-FromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-ToDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int p = 1; p <= paged.TotalPages; p++)
                            {
                                if (p == 1 || p == paged.TotalPages || (p >= paged.PageNumber - 2 && p <= paged.PageNumber + 2))
                                {
                                    <li class="page-item @(p == paged.PageNumber ? "active" : "")">
                                        <a class="page-link" asp-action="History"
                                           asp-route-Page="@p"
                                           asp-route-PageSize="@paged.PageSize"
                                           asp-route-SearchTerm="@filter.SearchTerm"
                                           asp-route-Status="@filter.Status"
                                           asp-route-PaymentMethod="@filter.PaymentMethod"
                                           asp-route-FromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                                           asp-route-ToDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))">
                                            @p
                                        </a>
                                    </li>
                                }
                                else if (p == paged.PageNumber - 3 || p == paged.PageNumber + 3)
                                {
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                }
                            }

                            <li class="page-item @(paged.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="History"
                                   asp-route-Page="@(paged.PageNumber + 1)"
                                   asp-route-PageSize="@paged.PageSize"
                                   asp-route-SearchTerm="@filter.SearchTerm"
                                   asp-route-Status="@filter.Status"
                                   asp-route-PaymentMethod="@filter.PaymentMethod"
                                   asp-route-FromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-ToDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>

    <!-- Security & Regulatory Disclosure -->
    <div class="card border-0 bg-light rounded-3 p-3">
        <div class="d-flex align-items-start gap-3">
            <div class="text-primary fs-4">
                <i class="bi bi-shield-check"></i>
            </div>
