@model MediCare.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-6 col-xl-5">
        <div class="card shadow-lg border-0 rounded-4 reveal reveal-scale is-visible">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="brand-icon mx-auto mb-3 text-primary bg-primary bg-opacity-10 d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; font-size: 1.6rem;">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1" data-i18n="resetPasswordTitle">Reset Your Password</h3>
                    <p class="text-muted small mb-0" data-i18n="resetPasswordSubtitle">Choose a strong, secure new password for your MediCare account.</p>
                </div>

                <form asp-action="ResetPassword" method="post" id="resetPasswordForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Code" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold" data-i18n="formEmail">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="name@example.com" data-i18n-ph="phEmail" readonly="@(!string.IsNullOrEmpty(Model.Email))" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- New Password Input -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold" data-i18n="newPasswordLabel">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" id="newPasswordInput" class="form-control border-start-0 border-end-0" placeholder="••••••••" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary border-start-0" id="togglePasswordBtn" tabindex="-1" title="Show/Hide Password">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>

                        <!-- Interactive Password Strength Meter -->
                        <div class="mt-2" id="strengthMeterContainer">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted" data-i18n="pwdSecurityLevel">Password Security Level:</span>
                                <span class="small fw-semibold" id="strengthText" data-i18n="pwdNotStarted">Not started</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar transition-all" id="strengthBar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>

                            <!-- Password Rules Checklist -->
                            <div class="row g-1 mt-2 small text-muted" id="rulesList">
                                <div class="col-12 d-flex align-items-center gap-1" id="ruleMinLength">
                                    <i class="bi bi-circle text-muted"></i>
                                    <span data-i18n="pwdRuleMinLength">At least 8 characters</span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-1" id="ruleUpper">
                                    <i class="bi bi-circle text-muted"></i>
                                    <span data-i18n="pwdRuleUpper">Uppercase (A-Z)</span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-1" id="ruleLower">
                                    <i class="bi bi-circle text-muted"></i>
                                    <span data-i18n="pwdRuleLower">Lowercase (a-z)</span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-1" id="ruleNumber">
                                    <i class="bi bi-circle text-muted"></i>
                                    <span data-i18n="pwdRuleNumber">Number (0-9)</span>
                                </div>
                                <div class="col-6 d-flex align-items-center gap-1" id="ruleSpecial">
                                    <i class="bi bi-circle text-muted"></i>
                                    <span data-i18n="pwdRuleSpecial">Special symbol (!@@#$%^&*)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Confirm Password Input -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold" data-i18n="confirmPasswordLabel">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-check"></i></span>
                            <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control border-start-0 border-end-0" placeholder="••••••••" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary border-start-0" id="toggleConfirmBtn" tabindex="-1" title="Show/Hide Password">
                                <i class="bi bi-eye" id="toggleConfirmIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        <div id="passwordMatchStatus" class="small mt-1 d-none"></div>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg py-2 fw-semibold" id="submitResetBtn">
                            <i class="bi bi-check-circle-fill me-1"></i> <span data-i18n="resetPasswordBtn">Reset Password</span>
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-secondary small fw-semibold text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i> <span data-i18n="backToLogin">Back to Sign In</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            // Password Show/Hide Toggle
            function setupToggle(btnId, inputId, iconId) {
                const btn = document.getElementById(btnId);
                const input = document.getElementById(inputId);
                const icon = document.getElementById(iconId);
                if (!btn || !input || !icon) return;

                btn.addEventListener('click', function() {
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    icon.classList.toggle('bi-eye', !isPassword);
                    icon.classList.toggle('bi-eye-slash', isPassword);
                });
            }

            setupToggle('togglePasswordBtn', 'newPasswordInput', 'togglePasswordIcon');
            setupToggle('toggleConfirmBtn', 'confirmPasswordInput', 'toggleConfirmIcon');

            // Password Strength Meter & Real-time Rule Validation
            const passwordInput = document.getElementById('newPasswordInput');
            const confirmInput = document.getElementById('confirmPasswordInput');
            const strengthBar = document.getElementById('strengthBar');
            const strengthText = document.getElementById('strengthText');
            const matchStatus = document.getElementById('passwordMatchStatus');

            const rules = {
                minLength: document.getElementById('ruleMinLength'),
                upper: document.getElementById('ruleUpper'),
                lower: document.getElementById('ruleLower'),
                number: document.getElementById('ruleNumber'),
                special: document.getElementById('ruleSpecial')
            };

            function updateRuleIcon(element, isValid) {
                if (!element) return;
                const icon = element.querySelector('i');
                if (!icon) return;
                if (isValid) {
                    icon.className = 'bi bi-check-circle-fill text-success';
                    element.classList.remove('text-muted');
                    element.classList.add('text-success');
                } else {
                    icon.className = 'bi bi-circle text-muted';
                    element.classList.remove('text-success');
                    element.classList.add('text-muted');
                }
            }

            function evaluateStrength(val) {
                if (!val) {
                    strengthBar.style.width = '0%';
                    strengthBar.className = 'progress-bar';
                    strengthText.textContent = window.currentLang === 'ar' ? 'لم تبدأ الكتابة بعد' : 'Not started';
                    strengthText.className = 'small fw-semibold text-muted';
                    Object.values(rules).forEach(r => updateRuleIcon(r, false));
                    return;
                }

                const checks = {
                    minLength: val.length >= 8,
                    upper: /[A-Z]/.test(val),
                    lower: /[a-z]/.test(val),
                    number: /[0-9]/.test(val),
                    special: /[^a-zA-Z0-9]/.test(val)
                };

                updateRuleIcon(rules.minLength, checks.minLength);
                updateRuleIcon(rules.upper, checks.upper);
                updateRuleIcon(rules.lower, checks.lower);
                updateRuleIcon(rules.number, checks.number);
                updateRuleIcon(rules.special, checks.special);

                let score = 0;
                if (checks.minLength) score += 2;
                if (checks.upper) score += 1;
                if (checks.lower) score += 1;
                if (checks.number) score += 1;
                if (checks.special) score += 1;

                const isAr = (document.documentElement.lang === 'ar' || window.currentLang === 'ar');

                if (score <= 2) {
                    strengthBar.style.width = '25%';
                    strengthBar.className = 'progress-bar bg-danger';
                    strengthText.textContent = isAr ? 'ضعيفة' : 'Weak';
                    strengthText.className = 'small fw-semibold text-danger';
                } else if (score <= 4) {
                    strengthBar.style.width = '60%';
                    strengthBar.className = 'progress-bar bg-warning';
                    strengthText.textContent = isAr ? 'متوسطة' : 'Fair';
                    strengthText.className = 'small fw-semibold text-warning';
                } else if (score === 5) {
                    strengthBar.style.width = '85%';
                    strengthBar.className = 'progress-bar bg-info';
                    strengthText.textContent = isAr ? 'قوية' : 'Strong';
                    strengthText.className = 'small fw-semibold text-info';
                } else {
                    strengthBar.style.width = '100%';
                    strengthBar.className = 'progress-bar bg-success';
                    strengthText.textContent = isAr ? 'قوية جداً' : 'Very Strong';
                    strengthText.className = 'small fw-semibold text-success';
                }
            }

            function checkMatch() {
                if (!confirmInput || !passwordInput || !matchStatus) return;
                const p = passwordInput.value;
                const c = confirmInput.value;
                if (!c) {
                    matchStatus.className = 'small mt-1 d-none';
                    return;
                }
                const isAr = (document.documentElement.lang === 'ar' || window.currentLang === 'ar');
                if (p === c) {
                    matchStatus.className = 'small mt-1 text-success d-block';
                    matchStatus.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ' + (isAr ? 'كلمتا المرور متطابقتان' : 'Passwords match');
                } else {
                    matchStatus.className = 'small mt-1 text-danger d-block';
                    matchStatus.innerHTML = '<i class="bi bi-exclamation-circle-fill me-1"></i> ' + (isAr ? 'كلمتا المرور غير متطابقتين' : 'Passwords do not match');
                }
            }

            passwordInput?.addEventListener('input', function() {
                evaluateStrength(this.value);
                checkMatch();
            });

            confirmInput?.addEventListener('input', checkMatch);

            // Form Submit Loading State
            document.getElementById('resetPasswordForm')?.addEventListener('submit', function() {
                if ($(this).valid()) {
                    const btn = document.getElementById('submitResetBtn');
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...';
                    }
                }
            });
        })();
    </script>
}
