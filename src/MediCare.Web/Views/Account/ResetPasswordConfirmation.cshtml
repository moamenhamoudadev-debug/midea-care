@{
    ViewData["Title"] = "Password Reset Complete";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4 reveal reveal-scale is-visible">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="mx-auto mb-3 text-success bg-success bg-opacity-10 d-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; font-size: 2rem;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                
                <h3 class="fw-bold text-dark mb-2" data-i18n="resetPasswordSuccessTitle">Password Reset Complete</h3>
                
                <p class="text-muted small mb-4" data-i18n="resetPasswordSuccessDesc">
                    Your password has been securely updated. You can now sign in to your MediCare account with your new credentials.
                </p>

                <div class="d-grid gap-2">
                    <a asp-action="Login" class="btn btn-primary py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> <span data-i18n="proceedToLoginBtn">Proceed to Sign In</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
