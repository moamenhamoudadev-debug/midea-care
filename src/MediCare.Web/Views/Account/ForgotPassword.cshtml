@model MediCare.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4 reveal reveal-scale is-visible">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="brand-icon mx-auto mb-3 text-primary bg-primary bg-opacity-10 d-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; font-size: 1.6rem;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1" data-i18n="forgotPasswordTitle">Forgot your password?</h3>
                    <p class="text-muted small mb-0" data-i18n="forgotPasswordSubtitle">Enter your registered email address and we'll send you a secure link to reset your password.</p>
                </div>

                <form asp-action="ForgotPassword" method="post" id="forgotPasswordForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label small fw-semibold" data-i18n="formEmail">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="name@example.com" data-i18n-ph="phEmail" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg py-2 fw-semibold" id="submitBtn">
                            <i class="bi bi-send-fill me-1"></i> <span data-i18n="sendResetLinkBtn">Send Password Reset Link</span>
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-secondary small fw-semibold text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i> <span data-i18n="backToLogin">Back to Sign In</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('forgotPasswordForm')?.addEventListener('submit', function() {
            if ($(this).valid()) {
                const btn = document.getElementById('submitBtn');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...';
                }
            }
        });
    </script>
}
