@{
    ViewData["Title"] = "Password Reset Requested";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4 reveal reveal-scale is-visible">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="mx-auto mb-3 text-success bg-success bg-opacity-10 d-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; font-size: 2rem;">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>
                
                <h3 class="fw-bold text-dark mb-2" data-i18n="forgotPasswordSentTitle">Check Your Email</h3>
                
                <p class="text-muted small mb-4" data-i18n="forgotPasswordSentDesc">
                    If an account exists with the email address you entered, a password reset link has been sent. Please check your inbox and spam folder.
                </p>

                <div class="alert alert-light border small text-muted text-start mb-4">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle text-primary mt-1"></i>
                        <div>
                            <span data-i18n="resetLinkExpiryNotice">For security reasons, this reset link is single-use and will expire in 2 hours.</span>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a asp-action="Login" class="btn btn-outline-primary py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> <span data-i18n="backToLogin">Return to Sign In</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
