@model MediCare.Services.DTOs.NotificationPagedResultDto
@{
    ViewData["Title"] = "Notification Center - MediCare";
    var activeType = (string)(ViewBag.ActiveType ?? "All");
    var isReadFilter = (bool?)ViewBag.IsReadFilter;
}

<div class="container-fluid px-3 px-md-4 py-4" style="max-width: 1050px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> <span data-i18n="breadcrumbHome">Home</span></a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <span data-i18n="notificationsTitle">Notifications</span>
            </li>
        </ol>
    </nav>

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-bell-fill text-primary"></i>
                <span data-i18n="notificationCenterTitle">Notification Center</span>
                @if (Model.UnreadCount > 0)
                {
                    <span class="badge bg-danger rounded-pill fs-6 px-2 py-1 align-middle" id="pageUnreadBadge">
                        @Model.UnreadCount unread
                    </span>
                }
            </h1>
            <p class="text-muted mb-0 small" data-i18n="notificationCenterSubtitle">
                Real-time updates regarding your consultation bookings, payment verifications, and financial refunds.
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.UnreadCount > 0)
            {
                <form asp-controller="Notifications" asp-action="MarkAllRead" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3 d-flex align-items-center gap-1 shadow-sm">
                        <i class="bi bi-check2-all fs-6"></i>
                        <span data-i18n="markAllRead">Mark All as Read</span>
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Navigation Pills -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="d-flex flex-wrap gap-1">
                <a asp-action="Index"
                   asp-route-type=""
                   asp-route-isRead=""
                   class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(activeType) && !isReadFilter.HasValue ? "btn-primary" : "btn-light text-secondary")">
                    <span data-i18n="filterAll">All</span>
                    <span class="badge rounded-pill bg-secondary-subtle text-dark ms-1">@Model.TotalItems</span>
                </a>

                <a asp-action="Index"
                   asp-route-type="@activeType"
                   asp-route-isRead="false"
                   class="btn btn-sm rounded-pill px-3 @(isReadFilter == false ? "btn-danger" : "btn-light text-secondary")">
                    <i class="bi bi-circle-fill fs-8 me-1 text-danger"></i>
                    <span data-i18n="filterUnread">Unread</span>
                    @if (Model.UnreadCount > 0)
                    {
                        <span class="badge rounded-pill bg-danger text-white ms-1">@Model.UnreadCount</span>
                    }
                </a>

                <a asp-action="Index"
                   asp-route-type="PaymentSuccess"
                   class="btn btn-sm rounded-pill px-3 @(activeType == "PaymentSuccess" ? "btn-primary" : "btn-light text-secondary")">
                    <i class="bi bi-credit-card me-1"></i> <span data-i18n="filterPayments">Payments</span>
                </a>

                <a asp-action="Index"
                   asp-route-type="RefundSucceeded"
                   class="btn btn-sm rounded-pill px-3 @(activeType == "RefundSucceeded" ? "btn-primary" : "btn-light text-secondary")">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> <span data-i18n="filterRefunds">Refunds</span>
                </a>

                <a asp-action="Index"
                   asp-route-type="AppointmentConfirmed"
                   class="btn btn-sm rounded-pill px-3 @(activeType == "AppointmentConfirmed" ? "btn-primary" : "btn-light text-secondary")">
                    <i class="bi bi-calendar-event me-1"></i> <span data-i18n="filterAppointments">Appointments</span>
                </a>
            </div>

            <div class="text-muted small px-2">
                Page @Model.PageNumber of @Math.Max(1, Model.TotalPages)
            </div>
        </div>
    </div>

    <!-- Notification Feed Items -->
    @if (Model.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-3 text-center py-5">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-bell-slash text-muted" style="font-size: 3.5rem;"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1" data-i18n="noNotificationsTitle">No Notifications Found</h5>
                <p class="text-muted small mb-3" data-i18n="noNotificationsSubtitle">
                    You're completely caught up! We will alert you here as soon as new appointment or payment events occur.
                </p>
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-calendar-plus me-1"></i> <span data-i18n="bookAppointment">Book an Appointment</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-4" id="notificationsFeed">
            @foreach (var notif in Model.Items)
            {
                var isUnread = !notif.IsRead;
                var iconClass = "bi-info-circle text-primary";
                var badgeClass = "bg-primary-subtle text-primary";
                var borderClass = isUnread ? "border-start border-4 border-primary bg-white shadow-sm" : "border bg-white text-muted shadow-xs";

                if (notif.Type.Contains("Success", StringComparison.OrdinalIgnoreCase) || notif.Type.Contains("Confirmed", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "bi-check-circle-fill text-success";
                    badgeClass = "bg-success-subtle text-success";
                }
                else if (notif.Type.Contains("Pending", StringComparison.OrdinalIgnoreCase) || notif.Type.Contains("UnderReview", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "bi-clock-history text-warning";
                    badgeClass = "bg-warning-subtle text-warning-emphasis";
                }
                else if (notif.Type.Contains("Failed", StringComparison.OrdinalIgnoreCase) || notif.Type.Contains("Rejected", StringComparison.OrdinalIgnoreCase) || notif.Type.Contains("Discrepancy", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "bi-x-circle-fill text-danger";
                    badgeClass = "bg-danger-subtle text-danger";
                }
                else if (notif.Type.Contains("Reconciliation", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "bi-shield-exclamation text-danger";
                    badgeClass = "bg-danger-subtle text-danger";
                }

                <div class="card rounded-3 @borderClass transition-hover p-3" id="notif_card_@notif.Id">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="d-flex align-items-start gap-3 flex-grow-1">
                            <div class="fs-4 lh-1 mt-1">
                                <i class="bi @iconClass"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <h5 class="h6 fw-bold mb-0 text-dark">
                                        @notif.Title
                                    </h5>
                                    <span class="badge @badgeClass rounded-pill small px-2 py-1">
                                        @notif.Type
                                    </span>
                                    @if (isUnread)
                                    {
                                        <span class="badge bg-danger rounded-pill small px-2 py-1">
                                            NEW
                                        </span>
                                    }
                                </div>
                                <p class="mb-2 text-secondary small lh-base">
                                    @notif.Message
                                </p>
                                <div class="d-flex align-items-center gap-3 flex-wrap small text-muted">
                                    <span><i class="bi bi-clock me-1"></i> @notif.CreatedAt.ToString("MMM dd, yyyy HH:mm") UTC</span>
                                    @if (!string.IsNullOrWhiteSpace(notif.ActionUrl))
                                    {
                                        <a href="@notif.ActionUrl" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-1">
                                            <span>View Details</span>
                                            <i class="bi bi-arrow-right fs-7"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (isUnread)
                        {
                            <form asp-controller="Notifications" asp-action="MarkRead" asp-route-id="@notif.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light border text-muted rounded-pill px-2 py-1 mark-read-action"
                                        title="Mark as read" aria-label="Mark notification as read">
                                    <i class="bi bi-check2"></i>
                                    <span class="d-none d-sm-inline small">Read</span>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center pt-2">
                <div>
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-type="@activeType"
                           asp-route-isRead="@isReadFilter"
                           class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                            <i class="bi bi-chevron-left me-1"></i> <span data-i18n="prevPage">Previous</span>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>
                            <i class="bi bi-chevron-left me-1"></i> <span data-i18n="prevPage">Previous</span>
                        </button>
                    }
                </div>

                <div class="small text-muted">
                    Page <span class="fw-bold text-dark">@Model.PageNumber</span> of <span class="fw-bold text-dark">@Model.TotalPages</span>
                </div>

                <div>
                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-type="@activeType"
                           asp-route-isRead="@isReadFilter"
                           class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                            <span data-i18n="nextPage">Next</span> <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>
                            <span data-i18n="nextPage">Next</span> <i class="bi bi-chevron-right ms-1"></i>
                        </button>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Optional client-side enhancement for mark read buttons without full page refresh
            document.querySelectorAll('.mark-read-action').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    const form = this.closest('form');
                    if (form) {
                        e.preventDefault();
                        const formData = new FormData(form);
                        fetch(form.action, {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        }).then(r => r.json()).then(data => {
                            if (data.success) {
                                const card = form.closest('.card');
                                if (card) {
                                    card.classList.remove('border-primary', 'border-start', 'border-4');
                                    card.classList.add('border', 'text-muted');
                                    form.remove();
                                }
                                const badge = document.getElementById('pageUnreadBadge');
                                if (badge) {
                                    let current = parseInt(badge.innerText, 10) || 0;
                                    current = Math.max(0, current - 1);
                                    if (current === 0) badge.remove();
                                    else badge.innerText = current + ' unread';
                                }
                            } else {
                                form.submit();
                            }
                        }).catch(() => form.submit());
                    }
                });
            });
        });
    </script>
}
