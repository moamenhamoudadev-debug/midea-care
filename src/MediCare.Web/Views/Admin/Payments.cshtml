@model MediCare.Services.DTOs.AdminFinancialDashboardDto
@{
    ViewData["Title"] = "Financial & Payment Dashboard - Admin";
    var filter = Model.ActiveFilter;
    var paged = Model.PagedTransactions;
    var queue = Model.ReconciliationQueue;
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> <span data-i18n="breadcrumbHome">Home</span></a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span data-i18n="adminPaymentsTitle">Financial & Payment Intelligence</span></li>
            </ol>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 reveal">
    <div>
        <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-wallet2 text-primary"></i> <span data-i18n="adminPaymentsTitle">Financial & Payment Intelligence</span>
        </h2>
        <p class="text-secondary mb-0" data-i18n="adminPaymentsSubtitle">Authoritative Paymob transactions, revenue intelligence, payment method distribution, and reconciliation queues.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Reports" class="btn btn-outline-primary">
            <i class="bi bi-bar-chart-line me-1"></i> <span data-i18n="reports">Clinical Reports</span>
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> <span data-i18n="dashboard">Dashboard</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #F0FDF4; border-left: 4px solid #22C55E !important; color: #166534;">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div class="flex-grow-1">
            <strong>Success:</strong> @TempData["SuccessMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #FEF2F2; border-left: 4px solid #EF4444 !important; color: #991B1B;">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div class="flex-grow-1">
            <strong>Notice:</strong> @TempData["ErrorMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Section 1: Financial KPI Cards (7 Core Principles) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3 reveal">
        <div class="card shadow-sm border-0 border-start border-4 border-success p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-semibold text-uppercase" data-i18n="grossPaymentsLabel">Gross Collected</span>
                <span class="badge bg-success-subtle text-success rounded-pill p-2"><i class="bi bi-cash-stack"></i></span>
            </div>
            <h3 class="fw-bold text-dark mb-0">@Model.GrossSuccessfulPayments.ToString("N2") <small class="fs-6 fw-normal text-muted">EGP</small></h3>
            <div class="text-success small mt-1">
                <i class="bi bi-check-circle me-1"></i> @Model.SucceededCount Succeeded (@Model.SuccessRatePercent%)
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3 reveal reveal-delay-1">
        <div class="card shadow-sm border-0 border-start border-4 border-danger p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-semibold text-uppercase" data-i18n="totalRefundsLabel">Total Refunds</span>
                <span class="badge bg-danger-subtle text-danger rounded-pill p-2"><i class="bi bi-arrow-counterclockwise"></i></span>
            </div>
            <h3 class="fw-bold text-danger mb-0">@Model.TotalRefundedAmount.ToString("N2") <small class="fs-6 fw-normal text-muted">EGP</small></h3>
            <div class="text-muted small mt-1">
                <span data-i18n="deductedFromNet">Deducted from net revenue</span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3 reveal reveal-delay-2">
        <div class="card shadow-sm border-0 border-start border-4 border-primary p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-semibold text-uppercase" data-i18n="netRevenueLabel">Net Confirmed Revenue</span>
                <span class="badge bg-primary-subtle text-primary rounded-pill p-2"><i class="bi bi-bank"></i></span>
            </div>
            <h3 class="fw-bold text-primary mb-0">@Model.NetRevenue.ToString("N2") <small class="fs-6 fw-normal text-muted">EGP</small></h3>
            <div class="text-muted small mt-1">
                <span data-i18n="netFormulaNote">Gross minus confirmed refunds</span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3 reveal reveal-delay-3">
        <div class="card shadow-sm border-0 border-start border-4 @(Model.RequiresRefundCount > 0 ? "border-danger" : "border-info") p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-semibold text-uppercase" data-i18n="reconciliationAlertsLabel">Action Required</span>
                <span class="badge @(Model.RequiresRefundCount > 0 ? "bg-danger text-white" : "bg-info-subtle text-info") rounded-pill p-2">
                    <i class="bi @(Model.RequiresRefundCount > 0 ? "bi-exclamation-octagon-fill" : "bi-shield-check")"></i>
                </span>
            </div>
            <h3 class="fw-bold @(Model.RequiresRefundCount > 0 ? "text-danger" : "text-dark") mb-0">@Model.RequiresRefundCount</h3>
            <div class="small mt-1">
                @if (Model.RequiresRefundCount > 0)
                {
                    <a href="#reconciliationQueueSection" class="text-danger fw-semibold text-decoration-none">
                        <i class="bi bi-arrow-down-circle me-1"></i> Review Queue Now
                    </a>
                }
                else
                {
                    <span class="text-muted">No unresolved disputes</span>
                }
            </div>
        </div>
    </div>

    <!-- Secondary KPI row: Gateway Attempts & Volumes -->
    <div class="col-4 col-md-4 reveal">
        <div class="card shadow-sm border-0 p-3 bg-light rounded-3 text-center">
            <div class="text-muted small fw-semibold text-uppercase" data-i18n="pendingAttemptsLabel">Pending Checkouts</div>
            <h4 class="fw-bold text-warning-emphasis mb-0 mt-1">@Model.PendingCount</h4>
            <span class="text-muted" style="font-size: 0.7rem;">Excluded from revenue</span>
        </div>
    </div>
    <div class="col-4 col-md-4 reveal">
        <div class="card shadow-sm border-0 p-3 bg-light rounded-3 text-center">
            <div class="text-muted small fw-semibold text-uppercase" data-i18n="failedAttemptsLabel">Declined & Expired</div>
            <h4 class="fw-bold text-secondary mb-0 mt-1">@Model.FailedCount</h4>
            <span class="text-muted" style="font-size: 0.7rem;">@Model.FailureRatePercent% of attempts</span>
        </div>
    </div>
    <div class="col-4 col-md-4 reveal">
        <div class="card shadow-sm border-0 p-3 bg-light rounded-3 text-center">
            <div class="text-muted small fw-semibold text-uppercase" data-i18n="totalAttemptsLabel">Total Attempts Handled</div>
            <h4 class="fw-bold text-dark mb-0 mt-1">@Model.TotalAttemptCount</h4>
            <span class="text-muted" style="font-size: 0.7rem;">Paymob sandbox gateway</span>
        </div>
    </div>
</div>

<!-- Section 2: Analytics & Payment Method Breakdown -->
<div class="row g-3 mb-4">
    <!-- Channel Breakdown Card -->
    <div class="col-12 col-lg-5 reveal">
        <div class="card shadow-sm border-0 p-4 bg-white rounded-3 h-100">
            <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-pie-chart-fill text-primary"></i> <span data-i18n="paymentChannelBreakdown">Payment Method Breakdown</span>
            </h5>
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold text-dark"><i class="bi bi-credit-card text-success me-1"></i> Bank Cards (Visa, MC, Meeza)</span>
                    <span class="fw-bold text-dark font-monospace">@Model.CardGrossRevenue.ToString("N2") EGP</span>
                </div>
                <div class="progress" style="height: 10px;">
                    @{
                        var cardPercent = Model.GrossSuccessfulPayments > 0 ? (Model.CardGrossRevenue / Model.GrossSuccessfulPayments * 100m) : 0m;
                    }
                    <div class="progress-bar bg-success" role="progressbar" style="width: @cardPercent%" aria-valuenow="@cardPercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="d-flex justify-content-between text-muted small mt-1">
                    <span>@Model.CardTransactionCount transactions</span>
                    <span>@cardPercent.ToString("F1")% of collected gross</span>
                </div>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold text-dark"><i class="bi bi-phone text-primary me-1"></i> Egyptian Mobile Wallets</span>
                    <span class="fw-bold text-dark font-monospace">@Model.WalletGrossRevenue.ToString("N2") EGP</span>
                </div>
                <div class="progress" style="height: 10px;">
                    @{
                        var walletPercent = Model.GrossSuccessfulPayments > 0 ? (Model.WalletGrossRevenue / Model.GrossSuccessfulPayments * 100m) : 0m;
                    }
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @walletPercent%" aria-valuenow="@walletPercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="d-flex justify-content-between text-muted small mt-1">
                    <span>@Model.WalletTransactionCount transactions</span>
                    <span>@walletPercent.ToString("F1")% of collected gross</span>
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 small text-muted">
                <i class="bi bi-info-circle text-primary me-1"></i>
                <span>Mobile wallet processing supports Vodafone Cash, Orange Cash, e& money, and WE Pay via Paymob Egyptian rail.</span>
            </div>
        </div>
    </div>

    <!-- 14-Day Revenue Progression -->
    <div class="col-12 col-lg-7 reveal reveal-delay-1">
        <div class="card shadow-sm border-0 p-4 bg-white rounded-3 h-100">
            <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-graph-up-arrow text-primary"></i> <span data-i18n="revenueTimeSeriesTitle">Revenue Trend (Last 14 Days)</span>
            </h5>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col" class="text-end">Gross Collected</th>
                            <th scope="col" class="text-end">Refunds</th>
                            <th scope="col" class="text-end">Net Revenue</th>
                            <th scope="col" class="text-center">Visits</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pt in Model.RevenueTimeSeries)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">@pt.PeriodLabel</td>
                                <td class="text-end font-monospace text-success">@pt.GrossRevenue.ToString("N2")</td>
                                <td class="text-end font-monospace text-danger">@(pt.RefundedAmount > 0 ? $"-{pt.RefundedAmount:N2}" : "0.00")</td>
                                <td class="text-end font-monospace fw-bold text-dark">@pt.NetRevenue.ToString("N2")</td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@pt.TransactionCount</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Section 3: Dedicated Reconciliation Queue (Urgent Administrative Section) -->
<div id="reconciliationQueueSection" class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden reveal">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-shield-exclamation text-danger fs-5"></i>
            <div>
                <h5 class="fw-bold mb-0 text-dark" data-i18n="reconciliationQueueTitle">Reconciliation Management Queue</h5>
                <span class="text-muted small" data-i18n="reconciliationQueueSubtitle">Transactions flagged for refund, post-cancellation receipts, or administrative resolution.</span>
            </div>
        </div>
        <div>
            @if (queue.Any())
            {
                <span class="badge bg-danger text-white rounded-pill px-3 py-2">
                    <i class="bi bi-bell-fill me-1"></i> @queue.Count Pending Resolution
                </span>
            }
            else
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                    <i class="bi bi-check-all me-1"></i> All Reconciled
                </span>
            }
        </div>
    </div>

    @if (!queue.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-shield-check display-4 text-success opacity-75"></i>
            <h6 class="fw-bold text-dark mt-3 mb-1">Queue Clear: Zero Outstanding Reconciliation Disputes</h6>
            <p class="text-muted small mb-0">All payment records match their scheduled clinical consultations without post-cancellation anomalies.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Transaction / Ref</th>
                        <th scope="col">Patient & Doctor</th>
                        <th scope="col">Appointment</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Alert Issue</th>
                        <th scope="col" class="text-end">Audit Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in queue)
                    {
                        <tr class="table-warning-subtle">
                            <td>
                                <div class="fw-bold font-monospace text-dark text-truncate" style="max-width: 170px;" title="@item.MerchantReference">
                                    @(item.ProviderTransactionId ?? item.MerchantReference)
                                </div>
                                <div class="text-muted" style="font-size: 0.75rem;">@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.PatientName</div>
                                <div class="text-muted small">@item.DoctorName</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">#@item.AppointmentId</span>
                                <span class="badge @(item.AppointmentStatus == "Cancelled" ? "bg-danger text-white" : "bg-secondary") ms-1">
                                    @item.AppointmentStatus
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark font-monospace">@item.AmountPaid.ToString("N2") @item.Currency</div>
                                <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">@item.PaymentMethodDetail</span>
                            </td>
                            <td>
                                <span class="badge bg-danger text-white mb-1">@item.ReconciliationStatus</span>
                                <div class="text-danger small" style="font-size: 0.75rem;">
                                    @(item.ReconciliationReason ?? "Payment completed post-cancellation; requires financial resolution.")
                                </div>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-danger fw-semibold"
                                        data-bs-toggle="modal"
                                        data-bs-target="#reconcileModal"
                                        data-attempt-id="@item.Id"
                                        data-ref="@(item.ProviderTransactionId ?? item.MerchantReference)"
                                        data-amount="@item.AmountPaid.ToString("N2")"
                                        data-patient="@item.PatientName"
                                        data-appt="@item.AppointmentId">
                                    <i class="bi bi-pencil-square me-1"></i> Resolve
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Section 3.5: Enterprise Maker-Checker Refund Review Queue -->
<div id="refundQueueSection" class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden reveal">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-arrow-counterclockwise text-danger fs-5"></i>
            <div>
                <h5 class="fw-bold mb-0 text-dark">Maker-Checker Refund Review Queue</h5>
                <span class="text-muted small">Refund requests requiring secondary administrator review pursuant to dual-authorization policy (&ge; 500 EGP).</span>
            </div>
        </div>
        <div>
            @if (Model.RefundQueue.Any(r => r.Status == "UnderReview" || r.Status == "Requested"))
            {
                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                    <i class="bi bi-hourglass-split me-1"></i> @Model.RefundQueue.Count(r => r.Status == "UnderReview" || r.Status == "Requested") Awaiting Checker Review
                </span>
            }
            else
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                    <i class="bi bi-check-circle me-1"></i> Refund Queue Clear
                </span>
            }
        </div>
    </div>

    @if (!Model.RefundQueue.Any())
    {
        <div class="card-body text-center py-4">
            <i class="bi bi-shield-check display-5 text-success opacity-75"></i>
            <h6 class="fw-bold text-dark mt-2 mb-1">Zero Pending Refund Approvals</h6>
            <p class="text-muted small mb-0">No refund requests currently require Maker-Checker authorization or execution.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Refund Ref</th>
                        <th scope="col">Transaction / Patient</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Reason</th>
                        <th scope="col">Maker / Checker</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rf in Model.RefundQueue)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold font-monospace text-dark">@rf.AuditReference</div>
                                <div class="text-muted small">@rf.RequestedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@rf.PatientName</div>
                                <div class="text-muted small font-monospace">@rf.ProviderTransactionId</div>
                            </td>
                            <td>
                                <div class="fw-bold text-danger font-monospace">@rf.AmountEgp.ToString("N2") EGP</div>
                                @if (rf.IsPartial)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.7rem;">Partial of @rf.OriginalAmountEgp.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger" style="font-size: 0.7rem;">Full Refund</span>
                                }
                            </td>
                            <td>
                                <div class="text-dark small text-truncate" style="max-width: 200px;" title="@rf.Reason">@rf.Reason</div>
                                @if (!string.IsNullOrEmpty(rf.FailureReason))
                                {
                                    <div class="text-danger small font-monospace" style="font-size: 0.72rem;">@rf.FailureReason</div>
                                }
                            </td>
                            <td>
                                <div class="text-muted small">Maker: <span class="fw-semibold text-dark">@rf.RequestedByAdminId</span></div>
                                @if (!string.IsNullOrEmpty(rf.ApprovedByAdminId))
                                {
                                    <div class="text-muted small">Checker: <span class="fw-semibold text-success">@rf.ApprovedByAdminId</span></div>
                                }
                            </td>
                            <td>
                                @if (rf.Status == "UnderReview" || rf.Status == "Requested")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Under Review</span>
                                }
                                else if (rf.Status == "Processing")
                                {
                                    <span class="badge bg-info text-white"><i class="bi bi-arrow-repeat me-1"></i> Processing</span>
                                }
                                else if (rf.Status == "Succeeded")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i> Succeeded</span>
                                }
                                else if (rf.Status == "Rejected")
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                                }
                                else if (rf.Status == "RequiresReconciliation")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Reconcile</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@rf.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (rf.CanCurrentAdminApprove)
                                {
                                    <button type="button" class="btn btn-sm btn-success me-1 approve-refund-btn"
                                            data-bs-toggle="modal" data-bs-target="#approveRefundModal"
                                            data-refund-id="@rf.RefundId"
                                            data-audit-ref="@rf.AuditReference"
                                            data-amount="@rf.AmountEgp.ToString("N2")"
                                            data-maker="@rf.RequestedByAdminId">
                                        <i class="bi bi-check-lg me-1"></i> Approve &amp; Execute
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger reject-refund-btn"
                                            data-bs-toggle="modal" data-bs-target="#rejectRefundModal"
                                            data-refund-id="@rf.RefundId"
                                            data-audit-ref="@rf.AuditReference">
                                        <i class="bi bi-x-lg me-1"></i> Reject
                                    </button>
                                }
                                else if (rf.Status == "UnderReview" || rf.Status == "Requested")
                                {
                                    <span class="badge bg-light text-muted border me-1" title="Self-approval blocked pursuant to segregation of duties policy">
                                        <i class="bi bi-lock-fill text-warning me-1"></i> Maker (Blocked)
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-danger reject-refund-btn"
                                            data-bs-toggle="modal" data-bs-target="#rejectRefundModal"
                                            data-refund-id="@rf.RefundId"
                                            data-audit-ref="@rf.AuditReference">
                                        <i class="bi bi-x-lg me-1"></i> Cancel
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<!-- Section 4: All Transactions Ledger & Advanced Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-table text-primary"></i> <span data-i18n="allTransactionsTitle">Authoritative Transaction Ledger</span>
        </h5>
    </div>
    <div class="card-body p-3 p-md-4">
        <!-- Filter Toolbar -->
        <form method="get" asp-action="Payments" class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1" data-i18n="searchFilterLabel">Search Ref / Doctor / Patient / Appt</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control" placeholder="Transaction ref, doctor, patient..." />
                </div>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1" data-i18n="statusFilterLabel">Status</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Succeeded" selected="@(string.Equals(filter.Status, "Succeeded", StringComparison.OrdinalIgnoreCase))">Succeeded</option>
                    <option value="Pending" selected="@(string.Equals(filter.Status, "Pending", StringComparison.OrdinalIgnoreCase))">Pending</option>
                    <option value="Failed" selected="@(string.Equals(filter.Status, "Failed", StringComparison.OrdinalIgnoreCase))">Failed / Expired</option>
                    <option value="Refunded" selected="@(string.Equals(filter.Status, "Refunded", StringComparison.OrdinalIgnoreCase))">Refunded</option>
                    <option value="RequiresRefund" selected="@(string.Equals(filter.Status, "RequiresRefund", StringComparison.OrdinalIgnoreCase))">Action Required</option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1" data-i18n="paymentMethodFilterLabel">Channel</label>
                <select name="PaymentMethod" class="form-select form-select-sm">
                    <option value="">All Methods</option>
                    <option value="Card" selected="@(string.Equals(filter.PaymentMethod, "Card", StringComparison.OrdinalIgnoreCase))">Credit / Debit Card</option>
                    <option value="MobileWallet" selected="@(string.Equals(filter.PaymentMethod, "MobileWallet", StringComparison.OrdinalIgnoreCase))">Mobile Wallet</option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1" data-i18n="fromDateLabel">From Date</label>
                <input type="date" name="FromDate" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1" data-i18n="toDateLabel">To Date</label>
                <input type="date" name="ToDate" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <div class="col-12 d-flex justify-content-between align-items-center pt-2 border-top flex-wrap gap-2">
                <div class="text-muted small">
                    @if (!string.IsNullOrWhiteSpace(filter.SearchTerm) || !string.IsNullOrWhiteSpace(filter.Status) || !string.IsNullOrWhiteSpace(filter.PaymentMethod) || filter.FromDate.HasValue || filter.ToDate.HasValue)
                    {
                        <span class="badge bg-light text-dark border me-2"><i class="bi bi-funnel-fill text-primary me-1"></i> Active Filters</span>
                        <a asp-action="Payments" class="text-decoration-none small text-danger"><i class="bi bi-x-circle me-1"></i> Reset</a>
                    }
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Payments" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> <span data-i18n="clearFilterBtn">Clear</span>
                    </a>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-filter me-1"></i> <span data-i18n="applyFilterBtn">Apply Filter</span>
                    </button>
                </div>
            </div>
        </form>

        @if (!paged.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt-cutoff display-1 text-secondary opacity-50"></i>
                <h6 class="fw-bold text-dark mt-3 mb-1" data-i18n="noPaymentRecordsTitle">No Payment Transactions Found</h6>
                <p class="text-muted small mb-0">No records match the active filter criteria.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col">Transaction Ref</th>
                            <th scope="col">Doctor & Specialty</th>
                            <th scope="col">Payment Channel</th>
                            <th scope="col">Amount</th>
                            <th scope="col">Status</th>
                            <th scope="col">Timestamp (UTC)</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in paged.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold font-monospace text-dark text-truncate" style="max-width: 170px;" title="@item.MerchantReference">
                                        @(item.ProviderTransactionId ?? item.MerchantReference)
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.ProviderOrderId))
                                    {
                                        <div class="text-muted font-monospace" style="font-size: 0.72rem;">Order: @item.ProviderOrderId</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.TermsVersion))
                                    {
                                        <span class="badge bg-light text-muted border text-truncate mt-1" style="font-size: 0.65rem;">
                                            <i class="bi bi-shield-check text-success"></i> @item.TermsVersion
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="fw-semibold text-dark">@item.DoctorName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@item.Specialization</div>
                                    <div class="text-secondary mt-1" style="font-size: 0.72rem;">
                                        <i class="bi bi-calendar-event me-1"></i> @item.AppointmentDate.ToString("yyyy-MM-dd")
                                        <span class="badge bg-light text-dark border ms-1">#@item.AppointmentId</span>
                                    </div>
                                </td>

                                <td>
                                    @if (string.Equals(item.PaymentMethodType, "MobileWallet", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-phone text-primary"></i>
                                            <span>@(item.PaymentMethodDetail ?? "Mobile Wallet")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-credit-card text-success"></i>
                                            <span>@(item.PaymentMethodDetail ?? "Card")</span>
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="fw-bold text-dark font-monospace">@item.AmountPaid.ToString("N2") @item.Currency</div>
                                    @if (item.DiscountAmount > 0)
                                    {
                                        <span class="text-success small" style="font-size: 0.72rem;">
                                            <i class="bi bi-tag-fill me-1"></i>-@item.DiscountAmount.ToString("N2") (@item.PromoCode)
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Status == "Succeeded")
                                    {
                                        if (item.IsRefunded)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> Refunded
                                            </span>
                                        }
                                        else if (item.ReconciliationStatus is "RequiresRefund" or "ReconciliationRequired" or "ManualInterventionRequired")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="@(item.ReconciliationReason ?? "Action required")">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Action Required
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle-fill me-1"></i> Succeeded
                                            </span>
                                        }
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                        </span>
                                    }
                                    else if (item.Status == "Expired")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="bi bi-clock-history me-1"></i> Expired
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-x-circle me-1"></i> Failed
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="text-dark">@item.CreatedAtUtc.ToString("yyyy-MM-dd")</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">@item.CreatedAtUtc.ToString("HH:mm:ss") UTC</div>
                                </td>

                                <td class="text-end">
                                    @if (item.CanViewReceipt)
                                    {
                                        <a asp-controller="Payment" asp-action="Receipt" asp-route-appointmentId="@item.AppointmentId" class="btn btn-sm btn-outline-primary" title="View Digital Receipt">
                                            <i class="bi bi-receipt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Appointments" asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-light border text-muted" title="View Appointment">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Server-Side Pagination -->
            @if (paged.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top mt-3">
                    <div class="small text-muted">
                        Showing <span class="fw-semibold">@((paged.PageNumber - 1) * paged.PageSize + 1)</span>
                        to <span class="fw-semibold">@Math.Min(paged.PageNumber * paged.PageSize, paged.TotalCount)</span>
                        of <span class="fw-semibold">@paged.TotalCount</span> transactions
                    </div>

                    <nav aria-label="Transactions pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(paged.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Payments"
                                   asp-route-Page="@(paged.PageNumber - 1)"
                                   asp-route-PageSize="@paged.PageSize"
                                   asp-route-SearchTerm="@filter.SearchTerm"
                                   asp-route-Status="@filter.Status"
                                   asp-route-PaymentMethod="@filter.PaymentMethod"
                                   asp-route-FromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-ToDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int p = 1; p <= paged.TotalPages; p++)
                            {
                                if (p == 1 || p == paged.TotalPages || (p >= paged.PageNumber - 2 && p <= paged.PageNumber + 2))
                                {
                                    <li class="page-item @(p == paged.PageNumber ? "active" : "")">
                                        <a class="page-link" asp-action="Payments"
                                           asp-route-Page="@p"
                                           asp-route-PageSize="@paged.PageSize"
                                           asp-route-SearchTerm="@filter.SearchTerm"
                                           asp-route-Status="@filter.Status"
                                           asp-route-PaymentMethod="@filter.PaymentMethod"
                                           asp-route-FromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                                           asp-route-ToDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))">
                                            @p
                                        </a>
                                    </li>
                                }
                                else if (p == paged.PageNumber - 3 || p == paged.PageNumber + 3)
                                {
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                }
                            }

                            <li class="page-item @(paged.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Payments"
                                   asp-route-Page="@(paged.PageNumber + 1)"
                                   asp-route-PageSize="@paged.PageSize"
                                   asp-route-SearchTerm="@filter.SearchTerm"
                                   asp-route-Status="@filter.Status"
                                   asp-route-PaymentMethod="@filter.PaymentMethod"
                                   asp-route-FromDate="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-ToDate="@(filter.ToDate?.ToString("yyyy-MM-dd"))">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- Modal: Resolve Financial Reconciliation -->
<div class="modal fade" id="reconcileModal" tabindex="-1" aria-labelledby="reconcileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="Reconcile">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AttemptId" id="modalAttemptId" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="reconcileModalLabel">
                        <i class="bi bi-shield-shaded me-1"></i> Administrative Reconciliation Resolution
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-light border small mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Transaction Ref:</span>
                            <span class="fw-bold font-monospace" id="modalRef">-</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Amount Paid:</span>
                            <span class="fw-bold text-success font-monospace" id="modalAmount">- EGP</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Patient / Appt:</span>
                            <span class="fw-bold" id="modalPatientAppt">-</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">
                            Select Resolution Decision <span class="text-danger">*</span>
                        </label>
                        <select name="Resolution" class="form-select form-select-sm" required>
                            <option value="">-- Choose Resolution Action --</option>
                            <option value="Refund">Authorize Full Refund (Mark as Refunded)</option>
                            <option value="Rebook">Allocate Credit for Clinic Rebooking</option>
                            <option value="Dismiss">Mark Investigated & Dismiss Alert</option>
                        </select>
                        <div class="form-text small">Authorizing refund deducts amount from net revenue.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">
                            Audit Notes / Explanation <span class="text-danger">*</span>
                        </label>
                        <textarea name="Notes" class="form-control form-control-sm" rows="3" minlength="5" maxlength="500" placeholder="State reason, ticket ID, bank refund reference..." required></textarea>
                        <div class="form-text small">Mandatory audit trail recorded against administrator username.</div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Commit Resolution
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Issue Refund Modal Handlers
            var issueModal = document.getElementById('issueRefundModal');
            if (issueModal) {
                issueModal.addEventListener('show.bs.modal', function (e) {
                    var btn = e.relatedTarget;
                    if (btn) {
                        var attemptId = btn.getAttribute('data-attempt-id');
                        var ref = btn.getAttribute('data-ref');
                        var maxAmt = btn.getAttribute('data-max');
                        document.getElementById('issueRefundAttemptId').value = attemptId;
                        document.getElementById('issueRefundRef').textContent = ref;
                        document.getElementById('issueRefundMaxDisplay').textContent = maxAmt + ' EGP';
                        var amtInput = document.getElementById('issueRefundAmount');
                        amtInput.max = maxAmt;
                        amtInput.value = maxAmt;
                        document.getElementById('fullRefundSwitch').checked = true;
                        amtInput.disabled = true;
                    }
                });

                var switchEl = document.getElementById('fullRefundSwitch');
                if (switchEl) {
                    switchEl.addEventListener('change', function () {
                        var amtInput = document.getElementById('issueRefundAmount');
                        if (this.checked) {
                            amtInput.disabled = true;
                        } else {
                            amtInput.disabled = false;
                        }
                    });
                }
            }

            // Approve Refund Modal Handlers
            var approveModal = document.getElementById('approveRefundModal');
            if (approveModal) {
                approveModal.addEventListener('show.bs.modal', function (e) {
                    var btn = e.relatedTarget;
                    if (btn) {
                        document.getElementById('approveRefundId').value = btn.getAttribute('data-refund-id');
                        document.getElementById('approveRefundAuditRef').textContent = btn.getAttribute('data-audit-ref');
                        document.getElementById('approveRefundAmountDisplay').textContent = btn.getAttribute('data-amount') + ' EGP';
                        document.getElementById('approveRefundMaker').textContent = btn.getAttribute('data-maker');
                    }
                });
            }

            // Reject Refund Modal Handlers
            var rejectModal = document.getElementById('rejectRefundModal');
            if (rejectModal) {
                rejectModal.addEventListener('show.bs.modal', function (e) {
                    var btn = e.relatedTarget;
                    if (btn) {
                        document.getElementById('rejectRefundId').value = btn.getAttribute('data-refund-id');
                        document.getElementById('rejectRefundAuditRef').textContent = btn.getAttribute('data-audit-ref');
                    }
                });
            }

            var modal = document.getElementById('reconcileModal');
            if (modal) {
                modal.addEventListener('show.bs.modal', function (event) {
                    var btn = event.relatedTarget;
                    if (btn) {
                        document.getElementById('modalAttemptId').value = btn.getAttribute('data-attempt-id');
                        document.getElementById('modalRef').textContent = btn.getAttribute('data-ref');
                        document.getElementById('modalAmount').textContent = btn.getAttribute('data-amount') + ' EGP';
                        document.getElementById('modalPatientAppt').textContent = btn.getAttribute('data-patient') + ' (Appt #' + btn.getAttribute('data-appt') + ')';
                    }
                });
            }
        });
    </script>
}
